{
  "name": "raybridge",
  "version": "1.0.0",
  "description": "MCP server exposing Raycast extension tools to MCP clients",
  "keywords": [
    "raycast",
    "mcp",
    "codex",
    "chatgpt",
    "claude",
    "claude-desktop",
    "claude-code",
    "http-server",
    "bun"
  ],
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "raybridge": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "start:http": "MCP_HTTP=true bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "dev:http": "MCP_HTTP=true bun --watch src/index.ts",
    "config": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test:config": "bun run src/test-config.ts",
    "test:logging": "bun run src/test-logging.ts",
    "test:catalog": "bun run src/test-catalog.ts",
    "test:worker": "bun run src/test-worker.ts",
    "test:shim-gates": "bun run src/test-shim-gates.ts",
    "test:shims": "bun run src/test-shims.ts",
    "test:shims:execute": "bun run src/test-shims.ts --execute",
    "verify:repo": "bun run typecheck && bun run test:config && bun run test:logging && bun run test:catalog && bun run test:worker && bun run test:shim-gates && bun run test:shims",
    "start:bg": "nohup bun run start:http > raybridge.log 2>&1 & echo $! > raybridge.pid && tail -f raybridge.log"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@raycast/api": "^1.104.13",
    "express": "^5.2.1"
  },
  "optionalDependencies": {
    "@opentui/core": "^0.1.103",
    "@opentui/react": "^0.1.103",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "ajv": "8.18.0",
    "brace-expansion": "2.0.3",
    "diff": "8.0.3",
    "file-type": "21.3.2",
    "hono": "4.12.15",
    "minimatch": "5.1.8",
    "path-to-regexp": "8.4.0",
    "picomatch": "4.0.4",
    "qs": "6.14.2"
  },
  "license": "MIT",
  "author": "Justin Lokos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlokos/raybridge.git"
  },
  "homepage": "https://github.com/jlokos/raybridge#readme",
  "bugs": {
    "url": "https://github.com/jlokos/raybridge/issues"
  }
}
